# =============================================================================
# Service Virtualization Platform — On-Prem Docker Compose Configuration
# =============================================================================
#
# Copy this file to .env and edit the two variables below.
# Both variables must be kept in sync with each other.
#
# Usage:
#   cp .env.example .env
#   docker compose up -d
#
# =============================================================================

# -----------------------------------------------------------------------------
# Step 1 — Which containers Docker Compose starts
# -----------------------------------------------------------------------------
# Core services:     mongodb, backend, ui
# Messaging brokers: kafka, ibmmq, tibco, activemq
#
# Examples:
#   All services:             mongodb,backend,ui,kafka,ibmmq,tibco,activemq
#   Core only (no brokers):   mongodb,backend,ui
#   External MongoDB:         backend,ui          (update mongodb URI in config/backend.properties)
# -----------------------------------------------------------------------------
COMPOSE_PROFILES=mongodb,backend,ui

# -----------------------------------------------------------------------------
# Step 2 — Spring Boot protocol activation
# -----------------------------------------------------------------------------
# Always start with: docker,mongodb
# Then append <protocol>-disabled for each protocol NOT listed in COMPOSE_PROFILES.
#
# Examples:
#   No brokers:            docker,mongodb,kafka-disabled,ibmmq-disabled,tibco-disabled,activemq-disabled
#   Kafka + IBM MQ only:   docker,mongodb,tibco-disabled,activemq-disabled
#   All brokers enabled:   docker,mongodb
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=docker,mongodb,kafka-disabled,ibmmq-disabled,tibco-disabled,activemq-disabled
